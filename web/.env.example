# Copy to .env.local (gitignored) and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

VITE_GOOGLE_MAPS_API_KEY=
# Optional: needed for the 3D tilted "follow" navigation view to actually render tilt/
# heading. Create one at console.cloud.google.com/google/maps-apis/studio/maps with
# render type "Vector". Without this, navigation still works but stays flat/top-down.
VITE_GOOGLE_MAPS_MAP_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
