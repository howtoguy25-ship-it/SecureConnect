# Firebase project config (Firebase Console -> Project Settings -> General -> Your apps -> Web app).
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time by Expo -- that's
# correct here, since Firebase's client config is meant to be public (security comes from
# Firebase Auth + Firestore rules, not from hiding this key).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud Console -> APIs & Services -> Credentials).
# Create an "iOS" OAuth client (bundle id com.sitespark.app) and a "Web" OAuth client
# (the Web one is required by Firebase's GoogleAuthProvider even for a mobile-only app).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Support contact shown in-app (already has real placeholder values from the product spec;
# these are read via app.config.js "extra", not EXPO_PUBLIC_, since they're static copy).
SUPPORT_PHONE="+61 408 680 813"
SUPPORT_EMAIL=support@buildsitespark.com

# Real crash reporting (sentry.io -> Settings -> Projects -> [project] -> Client Keys (DSN)).
# Safe to expose publicly -- a DSN only lets a client *send* events, same as a Firebase web
# config key. Without this set, src/services/crashReporting.ts is a no-op and the app behaves
# exactly as if it didn't exist; nothing else depends on it.
EXPO_PUBLIC_SENTRY_DSN=

# For readable (non-minified) stack traces in Sentry -- set these as EAS secrets
# (`eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value ...`), never here or
# in eas.json, since an auth token (unlike the DSN above) can create/modify data in Sentry.
# Until a real Sentry org/project exists, eas.json sets SENTRY_DISABLE_AUTO_UPLOAD=true on
# every build profile -- without it, sentry-cli's Xcode build phase fails the archive outright
# (not just a warning) because there's nothing to upload source maps to. Remove that env var
# from eas.json once these are set as EAS secrets.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
