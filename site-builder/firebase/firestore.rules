rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The account root doc (credits, plan) is server-managed only -- all writes go
    // through Cloud Functions using the Admin SDK, which bypasses these rules entirely.
    // Clients can read their own (for the credit balance UI) but never write directly, so
    // nobody can grant themselves credits.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Projects and unlocked-theme purchases are fully owned/edited by the client.
    match /users/{uid}/projects/{projectId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/meta/{docId} {
      allow read, write: if isOwner(uid);
    }

    // AI builder generation sessions (progress, pause state, credit deductions) are
    // written only by Cloud Functions -- the client reads for the live progress UI and
    // requests pauses/resumes through callable functions instead of writing the doc
    // directly, so nobody can fake a completed build or dodge credit deduction.
    match /users/{uid}/generationSessions/{sessionId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
