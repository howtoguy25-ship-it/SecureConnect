# Copy this file to .env and fill in real values.
# These are read by app.config / app.json's ${VAR} interpolation via `expo-env`
# or injected at EAS Build time as secrets. Never commit the real .env file.

# Google Maps SDK key, restricted to Maps SDK for Android/iOS
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Google Places Autocomplete API key, restricted to Places API
GOOGLE_PLACES_API_KEY=

# Google Directions API key, restricted to Directions API
GOOGLE_DIRECTIONS_API_KEY=

# Firebase project config (Project Settings -> General -> Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google AdMob (admob.google.com). Leave blank to use Google's own real test ads (they load
# and display normally, they just never earn revenue) -- useful for confirming ads work at
# all before setting up a real AdMob account/app/ad units.
# App IDs: admob.google.com -> Apps -> [your app] -> App settings (format ca-app-pub-...~...)
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# Ad unit IDs: admob.google.com -> Apps -> [your app] -> Ad units (format ca-app-pub-.../...)
ADMOB_ANDROID_BANNER_UNIT_ID=
ADMOB_IOS_BANNER_UNIT_ID=
ADMOB_ANDROID_APP_OPEN_UNIT_ID=
ADMOB_IOS_APP_OPEN_UNIT_ID=
