# Copy this file to .env and fill in real values. Never commit the real .env file.
# Read by app.config.js's process.env interpolation at Expo build/start time.

# Firebase project config (Firebase Console -> Project Settings -> General -> Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Maps SDK key for Android only (Google Cloud Console -> APIs & Services -> Credentials,
# restricted to "Maps SDK for Android"). The Discover map view needs nothing here for iOS --
# react-native-maps defaults to Apple Maps there, which is free and keyless.
GOOGLE_MAPS_ANDROID_API_KEY=

# Australian Business Register "ABN Lookup" web service GUID -- free, self-service signup at
# https://abr.business.gov.au/Tools/WebServices. Required for real ABN/ACN verification;
# without it, verifyBusiness() falls back to checksum-only validation (format-valid, not
# confirmed against the actual register).
ABR_LOOKUP_GUID=

# Anthropic API key: NOT set here. It's used server-side only by the aiDraftStoreProfile
# Cloud Function, and must be set as a Firebase Functions secret instead:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# Never put this in the mobile app's own .env -- that would ship it inside the app bundle.
