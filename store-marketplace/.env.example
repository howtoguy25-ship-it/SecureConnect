# Copy this file to .env and fill in real values. Never commit the real .env file.
# Read by app.config.js's process.env interpolation at Expo build/start time.

# Firebase project config (Firebase Console -> Project Settings -> General -> Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Maps SDK key (for the store-locator map view) + Places API key (search-by-name/address)
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Australian Business Register "ABN Lookup" web service GUID -- free, self-service signup at
# https://abr.business.gov.au/Tools/WebServices. Required for real ABN/ACN verification;
# without it, verifyBusiness() falls back to checksum-only validation (format-valid, not
# confirmed against the actual register).
ABR_LOOKUP_GUID=

# Anthropic API key, used server-side only (functions/.env, NOT this file) by the
# aiDraftStoreProfile Cloud Function to draft a suggested business profile/menu for an owner
# to review and edit. Never expose this in the mobile app's own env.
# ANTHROPIC_API_KEY= (set via `firebase functions:secrets:set ANTHROPIC_API_KEY`, see functions/README.md)
