# @tensorflow/tfjs-react-native@1.0.0 (used only for its rn-webgl GPU backend registration --
# see src/services/tfPlatform.ts) declares a stale peer dependency range on
# @react-native-async-storage/async-storage (^1.13.0) that predates this project's actual
# version (2.2.0, itself required by @firebase/auth's own peer range). The two packages don't
# actually conflict at runtime -- this app never calls into tfjs-react-native's AsyncStorage-
# using code path at all -- but npm's strict peer-dependency check fails the install outright
# without this. Without this file, `npm install` succeeds locally (if run once with
# --legacy-peer-deps) but fails on every fresh install elsewhere, EAS's build servers included,
# since they always run a real `npm install` from package.json, not just replay the lockfile.
legacy-peer-deps=true
